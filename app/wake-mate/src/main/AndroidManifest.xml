<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 이 선언은 required=false 이지만, 병합 결과(Pleos SDK 라이브러리 매니페스트 포함)에서는 required=true 가 된다.
         즉 설치 대상은 자동차(automotive) 기기다. -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <!-- 차속(android.car, 런타임 요청 후 승인: 에뮬레이터 실측) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- Pleos: 기어·조향각(조회), 공조(조회·제어: 2단계 외기 순환·풍량·온도), 위치(가까운 쉼터 계산 전용), 음성 안내·인식, 내비(쉼터 안내) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 백그라운드 감시(설정에서 동의 후 켠 경우만): 비위치 유형(specialUse) 포그라운드 서비스 + 지속 알림 + 부팅 완료 수신기.
         위치 유형 서비스·FOREGROUND_SERVICE_LOCATION·ACCESS_BACKGROUND_LOCATION·LOCKED_BOOT_COMPLETED·인터넷은 선언하지 않는다(위치 이력·네트워크 전송 없음) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <uses-library android:name="android.car" android:required="false" />
        <!-- 주의분산 최적화(DO) 선언: 앱 전체 + 액티비티 -->
        <meta-data android:name="distractionOptimized" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection|keyboard|keyboardHidden|navigation"
            android:resizeableActivity="true">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 졸음 감시 유지용 서비스: 차량 신호만 사용(위치 없음). 외부에서 시작 불가 -->
        <service
            android:name=".app.WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="운전 중 졸음 위험 감시(차속·조향 등 차량 신호만 사용, 위치 미사용). 사용자가 설정에서 동의하고 켠 경우에만 동작하며 지속 알림을 표시한다" />
        </service>

        <!-- 부팅 완료(잠금 해제 후) 시, 설정에서 백그라운드 감시를 켠 경우에만 서비스를 시작 -->
        <receiver android:name=".app.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
